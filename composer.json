{
    "name": "lwa/module-kit",
    "description": "Build-time helpers shared by lwa_ PrestaShop modules: PrestaShop 8/9 shims, token gate, install helpers, queue bridge, log bridge",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1 <8.6",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.4",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "LWA\\Kit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LWA\\Kit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable"
}
